{
  "name": "@parselo/capacitor-pdf417",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parselo-io/parselo-sdk.git",
    "directory": "packages/capacitor-pdf417"
  },
  "description": "Native PDF417 decode (Apple Vision / Android ML Kit) for Capacitor.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
